+/*
+ * FSIN, FCOS, FSINCOS and FPTAN compute their results with the full 64-bit significand of the
+ * operand and deliver a 64-bit significand regardless of the precision control. They are
+ * evaluated here in the binary128 long double of the host, into which a floatx80 converts
+ * exactly, and rounded to the nearest floatx80.
+ */
+QEMU_BUILD_BUG_ON(sizeof(long double) != 16 || LDBL_MANT_DIG != 113);
+
+static long double x87_to_quad(floatx80 a)
+{
+    float_status status = { .float_rounding_mode = float_round_nearest_even };
+    float128 q = floatx80_to_float128(a, &status);
+    long double r;
+
+    memcpy(&r, &q, sizeof(r));
+    return r;
+}
+
+static floatx80 quad_to_x87(long double r)
+{
+    float_status status = {
+        .float_rounding_mode = float_round_nearest_even,
+        .floatx80_rounding_precision = floatx80_precision_x,
+    };
+    float128 q;
+
+    memcpy(&q, &r, sizeof(q));
+    return float128_to_floatx80(q, &status);
+}
+
 void helper_fptan(CPUX86State *env)
 {
     double fptemp = floatx80_to_double(env, ST0);
@@ -1307,8 +1338,7 @@ void helper_fptan(CPUX86State *env)
     if ((fptemp > MAXTAN) || (fptemp < -MAXTAN)) {
         env->fpus |= 0x400;
     } else {
-        fptemp = tan(fptemp);
-        ST0 = double_to_floatx80(env, fptemp);
+        ST0 = quad_to_x87(tanl(x87_to_quad(ST0)));
         fpush(env);
         ST0 = floatx80_one;
