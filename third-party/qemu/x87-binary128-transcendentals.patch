     } else {
-        ST0 = double_to_floatx80(env, sin(fptemp));
+        long double x = x87_to_quad(ST0);
+
+        ST0 = quad_to_x87(sinl(x));
         fpush(env);
-        ST0 = double_to_floatx80(env, cos(fptemp));
+        ST0 = quad_to_x87(cosl(x));
