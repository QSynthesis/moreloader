+/*
+ * FSIN, FCOS, FSINCOS and FPTAN compute their results with the full 64-bit significand of the
+ * operand and deliver a 64-bit significand regardless of the precision control. The processor
+ * reduces the operand by a multiple of pi/2 rounded to 66 bits, and near a zero of the function
+ * that constant, not pi, determines the result. The reduction is performed here with the same
+ * constant and a single rounding, the reduced operand is evaluated in the binary128 long double
+ * of the host, into which a floatx80 converts exactly, and the result is rounded to the nearest
+ * floatx80.
+ */
+QEMU_BUILD_BUG_ON(sizeof(long double) != 16 || LDBL_MANT_DIG != 113);
+
+static long double x87_to_quad(floatx80 a)
+{
+    float_status status = { .float_rounding_mode = float_round_nearest_even };
+    float128 q = floatx80_to_float128(a, &status);
+    long double r;
+
+    memcpy(&r, &q, sizeof(r));
+    return r;
+}
+
+static floatx80 quad_to_x87(long double r)
+{
+    float_status status = {
+        .float_rounding_mode = float_round_nearest_even,
+        .floatx80_rounding_precision = floatx80_precision_x,
+    };
+    float128 q;
+
+    memcpy(&q, &r, sizeof(q));
+    return float128_to_floatx80(q, &status);
+}
+
+/* Returns x - k * pi/2 for the nearest integer k, and k modulo 4 in *quadrant. */
+static long double x87_reduce(long double x, int *quadrant)
+{
+    /* pi/2 rounded to 66 bits: the significand c90fdaa22168c234 followed by the bits 11. */
+    const long double half_pi =
+        ldexpl((long double)0xc90fdaa22168c234ULL, -63) + ldexpl(3.0L, -65);
+    long double k = nearbyintl(x / half_pi);
+
+    *quadrant = (int)((long long)k & 3);
+    return fmal(-k, half_pi, x);
+}
+
+static long double x87_sin(long double x)
+{
+    int q;
+    long double r = x87_reduce(x, &q);
+
+    return q == 0 ? sinl(r) : q == 1 ? cosl(r) : q == 2 ? -sinl(r) : -cosl(r);
+}
+
+static long double x87_cos(long double x)
+{
+    int q;
+    long double r = x87_reduce(x, &q);
+
+    return q == 0 ? cosl(r) : q == 1 ? -sinl(r) : q == 2 ? -cosl(r) : sinl(r);
+}
+
+static long double x87_tan(long double x)
+{
+    int q;
+    long double r = x87_reduce(x, &q);
+
+    return (q & 1) ? -cosl(r) / sinl(r) : tanl(r);
+}
+
